# Optional provider configuration for local development.
# Keep real credentials in .env; never commit them.
GMAIL_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-desktop-client-secret

# Optional AI provider configuration used by the desktop main process.
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
